# Scraped data stays local by default (re-creatable by running the scripts).
# If you want a frozen snapshot in git, remove these two lines deliberately.
data/raw/*
!data/raw/.gitkeep

# Generated charts (re-creatable by R/comparisons.R)
figures/

# Python litter
__pycache__/
*.pyc
.venv/

# R litter
.Rhistory
.RData
